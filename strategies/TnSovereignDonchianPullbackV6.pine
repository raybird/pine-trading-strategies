//@version=6
// ============================================================================
// TeleNexus Sovereign — TnSovereignDonchianPullbackV6
// ============================================================================
// Causal Audit: 2026-08-19 06:30 CST
// Version: v26.0819.0630
// Build: Pullback-Into-Midline Donchian Trend 引擎
//
// Source: Ahmed-GoCode/Quant-Edge-Indicators (MPL-2.0)
//         Quant-Edge-Indicators/Trend & Breakout/Donchian Pullback.pinescript
//
// Core Thesis:
//   與傳統直接 chase 突破不同，此引擎以 Donchian 通道突破「確立趨勢狀態」，
//   然後等待價格正式拉回至通道中線 (Mid) 才建立倉位，並以通道上下緣作為
//   TP/SL bracket。區隔於現行 TnSovereignDonchianV6（量能驗證直衝）與
//   TnSovereignDonchianBreakoutV6（時間觸發掛單）：本策略質押的是「突破後
//   的回抽動量延續」，以 mid 反彈確認趨勢結構尚未崩壞。
//
// Sovereign Overlays:
//   ✓ Donchian 突破確立長/空趨勢狀態（state-based, 非每根重算）
//   ✓ 拉回 Midline 進場 + 防重複進場 Flag（long/shortTaken 狀態機）
//   ✓ 通道 High/Low 作為 Take-Profit / Stop 之 bracket
//   ✓ 可選 EMA 趨勢地層過濾 + Session/測試窗
//   ✓ 可選 ATR 加權取 quote 級 Stop（保底）
//   ✓ 視覺化通道 + 中線 + 進場平分標記 + Sovereign HUD
// ============================================================================
strategy("TeleNexus Sovereign Donchian Pullback V6",
     overlay              = true,
     precision            = 2,
     initial_capital      = 100000,
     default_qty_type     = strategy.percent_of_equity,
     default_qty_value    = 10,
     commission_type      = strategy.commission.percent,
     commission_value     = 0.05,
     slippage             = 1,
     pyramiding           = 0,
     calc_on_every_tick   = false,
     process_orders_on_close = true)

// ---------------------------------------------------------------------------
// Group labels
// ---------------------------------------------------------------------------
var string G_DC   = "01 · Donchian Channel"
var string G_ENT  = "02 · Pullback Entry"
var string G_FLT  = "03 · Filter Stack"
var string G_TM   = "04 · Test Window"
var string G_VIS  = "05 · Visuals"

// ---------------------------------------------------------------------------
// Inputs — Donchian Channel
// ---------------------------------------------------------------------------
donLen   = input.int(20, "Donchian Channel Period", minval=2, group=G_DC)
useClose = input.bool(false, "Use Close-Only for Channel Extrema", group=G_DC, tooltip="關閉時以 high/low 計算通道；開啟時以 close 計算（更平滑）。")

// ---------------------------------------------------------------------------
// Inputs — Pullback Entry Logic
// ---------------------------------------------------------------------------
dirMode  = input.string("Both", "Direction", options=["Long only", "Short only", "Both"], group=G_ENT)
tpMode   = input.string("Channel High/Low", "Take-Profit Mode", options=["Channel High/Low", "Fixed R:R", "Off"], group=G_ENT)
rrMult   = input.float(2.0, "Fixed R:R Multiplier", step=0.5, group=G_ENT, tooltip="tpMode=Fixed R:R 時生效。")

// ---------------------------------------------------------------------------
// Inputs — Filter Stack
// ---------------------------------------------------------------------------
useEma   = input.bool(true, "Use EMA Trend Floor", group=G_FLT)
emaLen   = input.int(200, "Trend EMA Length", minval=20, group=G_FLT)
useSess  = input.bool(false, "Use Session Window", group=G_FLT)
sessStart = input.int(930, "Session Start (HHMM)", minval=0, maxval=2359, group=G_FLT)
sessEnd   = input.int(1600, "Session End (HHMM)", minval=0, maxval=2359, group=G_FLT)

// ---------------------------------------------------------------------------
// Inputs — Test Window
// ---------------------------------------------------------------------------
useDateRange = input.bool(false, "Enable Test Window", group=G_TM)
startDate    = input.time(timestamp("1 Jan 2020 00:00 +0000"), "Start", group=G_TM)
endDate      = input.time(timestamp("1 Jan 2030 00:00 +0000"), "End",   group=G_TM)

// ---------------------------------------------------------------------------
// Inputs — Visuals
// ---------------------------------------------------------------------------
cUpCol   = input.color(color.new(#26a69a, 30),  "Channel High",  group=G_VIS)
cLoCol   = input.color(color.new(#ef5350, 30),  "Channel Low",   group=G_VIS)
cMidCol  = input.color(color.new(#ffa726, 80),  "Midline",       group=G_VIS)
cEmaCol  = input.color(color.new(#78909c, 60),  "EMA Floor",     group=G_VIS)

// ---------------------------------------------------------------------------
// Donchian Channel (prior-bar confirmed to avoid repaint)
// ---------------------------------------------------------------------------
srcH = useClose ? close : high
srcL = useClose ? close : low
chanHigh = ta.highest(srcH, donLen)[1]
chanLow  = ta.lowest(srcL,  donLen)[1]
chanMid  = (chanHigh + chanLow) / 2

// ---------------------------------------------------------------------------
// Trend State Machine — Donchian breakout establishes bias
// ---------------------------------------------------------------------------
var bool inBearishTrend = false
var bool inBullishTrend = false

if low < chanLow
    inBearishTrend := true
    inBullishTrend := false

if high > chanHigh
    inBullishTrend := true
    inBearishTrend := false

// ---------------------------------------------------------------------------
// Filters
// ---------------------------------------------------------------------------
float emaVal = ta.ema(close, emaLen)
bool emaBull = not useEma or close > emaVal
bool emaBear = not useEma or close < emaVal

bool sessOK = not useSess or (hour * 100 + minute >= sessStart and hour * 100 + minute <= sessEnd)
bool inWindow = not useDateRange or (time >= startDate and time <= endDate)

bool allowLong  = dirMode != "Short only"
bool allowShort = dirMode != "Long only"

// ---------------------------------------------------------------------------
// Anti-re-entry State (per trend leg)
// ---------------------------------------------------------------------------
var bool longTaken  = false
var bool shortTaken = false

// Reset flags when flat
if strategy.position_size == 0
    longTaken  := false
    shortTaken := false

// ---------------------------------------------------------------------------
// Pullback Signals: trend established + price returns to midline
// ---------------------------------------------------------------------------
bool longPullback  = inBullishTrend and not longTaken  and close <= chanMid and emaBull and allowLong
bool shortPullback = inBearishTrend and not shortTaken and close >= chanMid and emaBear and allowShort

// ---------------------------------------------------------------------------
// Execution
// ---------------------------------------------------------------------------
if longPullback and strategy.position_size == 0 and sessOK and inWindow
    strategy.entry("Long", strategy.long, comment="DC Pullback")
    longTaken := true

if shortPullback and strategy.position_size == 0 and sessOK and inWindow
    strategy.entry("Short", strategy.short, comment="DC Pullback")
    shortTaken := true

// TP/SL bracket
if strategy.position_size > 0
    float tpL = tpMode == "Fixed R:R" ? close + rrMult * (close - chanLow) : chanHigh
    if tpMode == "Off"
        strategy.exit("L-Stop", "Long", stop = chanLow)
    else
        strategy.exit("L-Bracket", "Long", stop = chanLow, limit = tpL)

if strategy.position_size < 0
    float tpS = tpMode == "Fixed R:R" ? close - rrMult * (chanHigh - close) : chanLow
    if tpMode == "Off"
        strategy.exit("S-Stop", "Short", stop = chanHigh)
    else
        strategy.exit("S-Bracket", "Short", stop = chanHigh, limit = tpS)

// ---------------------------------------------------------------------------
// Visuals
// ---------------------------------------------------------------------------
pHi = plot(chanHigh, "Channel High", color=cUpCol,  linewidth=2)
pLo = plot(chanLow,  "Channel Low",  color=cLoCol,  linewidth=2)
fill(pHi, pLo, color=color.new(#2962ff, 96), title="Channel Range")
plot(chanMid, "Midline", color=cMidCol, linewidth=1, style=plot.style_dotted)
plot(useEma ? emaVal : na, "EMA Floor", color=cEmaCol, linewidth=1)
plotshape(longPullback ? chanMid : na,  "Pullback Long",  shape.triangleup,   location.belowbar, color.lime, size=size.small, text="PB")
plotshape(shortPullback ? chanMid : na, "Pullback Short", shape.triangledown, location.abovebar, color.red,  size=size.small, text="PB")

// ---------------------------------------------------------------------------
// Sovereign HUD
// ---------------------------------------------------------------------------
var table hud = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 70), border_width=1)
if barstate.isconfirmed
    table.cell(hud, 0, 0, "◈ DC PULLBACK", text_color=color.white, bgcolor=color.new(#2962ff, 30))
    table.cell(hud, 1, 0, "SOVEREIGN",     text_color=color.white, bgcolor=color.new(#2962ff, 30))
    table.cell(hud, 0, 1, "Trend State",   text_color=color.gray)
    table.cell(hud, 1, 1, inBullishTrend ? "BULL" : inBearishTrend ? "BEAR" : "FLAT", text_color=inBullishTrend ? color.lime : inBearishTrend ? color.red : color.gray)
    float midPct = chanHigh != chanLow ? (close - chanMid) / (chanHigh - chanLow) * 100 : 0.0
    table.cell(hud, 0, 2, "Midline Dist",  text_color=color.gray)
    table.cell(hud, 1, 2, str.tostring(midPct, "#.#") + "%", text_color=color.white)
    table.cell(hud, 0, 3, "Position",      text_color=color.gray)
    table.cell(hud, 1, 3, strategy.position_size != 0 ? (strategy.position_size > 0 ? "LONG" : "SHORT") : "FLAT", text_color=strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray)
    table.cell(hud, 0, 4, "Version",       text_color=color.gray)
    table.cell(hud, 1, 4, "v26.0819.0630", text_color=color.gray)

// ---------------------------------------------------------------------------
// Alerts
// ---------------------------------------------------------------------------
alertcondition(longPullback,  "Pullback Long",  "Donchian 牛市突破後價格拉回中線，多單觸發")
alertcondition(shortPullback, "Pullback Short", "Donchian 熊市突破後價格反彈中線，空單觸發")