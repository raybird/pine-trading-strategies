//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  TeleNexus Sovereign IBS Mean Reversion V6
//  主權化移植自 Aitradingroom/ai-trading-room (MIT License, Copyright 2026 AI Trading Room)
//  strategies/ibs-mean-reversion/ibs_mean_reversion.pine
// ═══════════════════════════════════════════════════════════════════════════
//  Version   : v26.1118.0630
//  Timestamp : 2026-11-18 06:30 CST (UTC+8)
//  Source    : Aitradingroom/ai-trading-room — MIT — IBS Mean Reversion
//  Core      : IBS（Internal Bar Strength）＝ (close − low) / (high − low)。
//              收盤落在當日區間下端（IBS 低）+ 價格低於「N 日高點 − k ×
//              平均真實區間」之拉回帶 → 建立多頭；收盤突破前日高點出場。
//              IBS 為單一 K 棒的「收盤位置」資訊，與 zip 收盤價平均值不同，
//              本庫既有多頭反轉策略皆未以 IBS 為進場主證據。
//
//  主權化要點（相對原作者）
//    1. 原作者無停損（僅以前日高點出場）→ 加入 ATR 硬停損 + R 倍數停利 +
//       1R 保本 + 最長持倉；徹底封閉無限風險
//    2. 原作者以 startYear / endYear 日期窗綁死回測 → 改為時段 / 每日平倉 /
//       持倉上限 / 冷卻之時間紀律，無選擇偏誤
//    3. 原作者 process_orders_on_close = true → 改 false 且訊號僅於
//       已收盤 K 棒判定，訂單下一根開盤成交（非重繪）
//    4. 部位由固定 100% 權益改為風險距離定倉 + 名目槓桿封頂，qty 以 int 落地
//    5. 新增日線 EMA 體制閘門（lookahead_on + ignore_invalid_symbol）、
//       選配 RVOL 流動性閘門、選配空頭鏡像、JSON Webhook 與因果儀表板
//    6. 移除任何績效宣稱字串
// ═══════════════════════════════════════════════════════════════════════════
strategy("Tn Sovereign IBS Mean Reversion V6", "TnIBS_v26",
     overlay = true,
     initial_capital = 50000,
     currency = currency.USD,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.percent,
     commission_value = 0.02,
     slippage = 1,
     pyramiding = 0,
     calc_on_every_tick = false,
     process_orders_on_close = false,
     max_bars_back = 500)

// ─────────────────────────────────────────────────────────────────────────
//  INPUTS
// ─────────────────────────────────────────────────────────────────────────
GRP_I = "① IBS 拉回設定 (IBS Setup)"
lenH     = input.int(10, "拉回帶：最高價回溯週期", minval = 2, group = GRP_I)
lenR     = input.int(25, "平均區間週期", minval = 2, group = GRP_I)
mult     = input.float(2.5, "拉回帶：k × 平均區間", minval = 0.1, step = 0.1, group = GRP_I)
useBand  = input.bool(true, "要求收盤低於拉回帶", group = GRP_I)
ibsTh    = input.float(0.30, "IBS 進場門檻（0＝收在最低、1＝收在最高）", minval = 0.0, maxval = 1.0, step = 0.05, group = GRP_I)
allowShort = input.bool(false, "啟用空頭鏡像（IBS 高檔 + 高於推進帶）", group = GRP_I)

GRP_E = "② 出場 (Exits)"
useAtrStop = input.bool(true, "啟用 ATR 硬停損（強烈建議）", group = GRP_E)
stopAtr    = input.float(2.0, "停損距離 (×ATR)", minval = 0.25, step = 0.25, group = GRP_E)
targetR    = input.float(2.5, "停利目標 (R)，0＝停用", minval = 0.0, step = 0.25, group = GRP_E)
useBE      = input.bool(true, "1R 後保本", group = GRP_E)
maxHold    = input.int(10, "最長持倉 K 棒", minval = 1, group = GRP_E)
usePrevHighExit = input.bool(true, "收盤突破前日高點出場（原作者出場）", group = GRP_E)

GRP_R = "③ 風險與紀律 (Risk)"
riskPct   = input.float(0.5, "單筆風險 (% 權益)", minval = 0.1, maxval = 5.0, step = 0.1, group = GRP_R)
useLevCap = input.bool(true, "啟用名目槓桿上限", group = GRP_R)
maxLev    = input.float(2.0, "最大名目槓桿（名目 / 權益）", minval = 0.5, step = 0.25, group = GRP_R)
cooldownBars = input.int(1, "出場後冷卻 K 棒", minval = 0, group = GRP_R)
maxDD     = input.float(20.0, "最大回撤守門 (%)（0＝停用）", minval = 0.0, step = 1.0, group = GRP_R)

GRP_F = "④ 濾網 (Filters)"
useDaily = input.bool(true, "啟用日線 EMA 體制閘門", group = GRP_F)
dailyLen = input.int(200, "日線 EMA 週期", minval = 20, maxval = 500, group = GRP_F)
useSession = input.bool(false, "啟用進場時段濾網", group = GRP_F)
sessionStr = input.session("0000-2345", "進場時段", group = GRP_F)
useEodFlat = input.bool(false, "每日強制平倉", group = GRP_F)
eodHour    = input.int(15, "平倉小時", minval = 0, maxval = 23, group = GRP_F)
eodMinute  = input.int(55, "平倉分鐘", minval = 0, maxval = 59, group = GRP_F)
useRvol    = input.bool(false, "啟用 RVOL 流動性閘門", group = GRP_F)
rvolMin    = input.float(0.8, "RVOL 下限", minval = 0.1, step = 0.1, group = GRP_F)

GRP_D = "⑤ 顯示 (Display)"
showLevels  = input.bool(true, "顯示拉回帶 / 10 日高點", group = GRP_D)
showSignals = input.bool(true, "顯示訊號", group = GRP_D)
showDash    = input.bool(true, "顯示因果儀表板", group = GRP_D)
useWebhook  = input.bool(false, "啟用 JSON Webhook", group = GRP_D)

// ─────────────────────────────────────────────────────────────────────────
//  核心量（僅已收盤值；日線取已收盤 K 棒，標的不可用時 fail-closed）
// ─────────────────────────────────────────────────────────────────────────
float rangeAvg = ta.sma(high - low, lenR)
float band     = ta.highest(high, lenH) - mult * rangeAvg
float ibs      = high > low ? (close - low) / (high - low) : 0.5
float atrV     = ta.atr(14)
float pushBand = ta.lowest(low, lenH) + mult * rangeAvg
float dEma     = request.security(syminfo.tickerid, "1D", ta.ema(close, dailyLen), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
float prevHigh = request.security(syminfo.tickerid, "1D", high, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
float prevLow  = request.security(syminfo.tickerid, "1D", low, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
bool dailyLongOk  = not useDaily or (not na(dEma) and close > dEma)
bool dailyShortOk = not useDaily or (not na(dEma) and close < dEma)

float rvolV = na
if useRvol
    float volAvg = ta.sma(volume, lenR)
    rvolV := volAvg > 0 ? volume / volAvg : na
bool rvolOk = not useRvol or (not na(rvolV) and rvolV >= rvolMin)

float riskDist = math.max(stopAtr * atrV, syminfo.mintick)
bool ddOk = maxDD <= 0 or strategy.equity >= strategy.initial_capital * (1.0 - maxDD / 100.0)

var int lastExitBar = na
bool justClosed = strategy.closedtrades > 0 and strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1) == bar_index
if justClosed
    lastExitBar := bar_index
bool inCooldown = cooldownBars > 0 and not na(lastExitBar) and (bar_index - lastExitBar) < cooldownBars

bool sessionOk = not useSession or not na(time(timeframe.period, sessionStr))
bool baseOk = barstate.isconfirmed and strategy.position_size == 0 and sessionOk and ddOk and rvolOk and not inCooldown

bool ibsLong  = baseOk and dailyLongOk and ibs < ibsTh and (not useBand or close < band)
bool ibsShort = allowShort and baseOk and dailyShortOk and ibs > (1.0 - ibsTh) and (not useBand or close > pushBand)

// 風險距離定倉 + 名目槓桿封頂
float qtyRaw = strategy.equity * riskPct / 100.0 / riskDist / math.max(syminfo.pointvalue, 1.0)
int qty = int(math.max(1, math.floor(qtyRaw)))
if useLevCap
    int qtyCap = int(math.floor(strategy.equity * maxLev / math.max(close * syminfo.pointvalue, syminfo.mintick)))
    qty := math.min(qty, math.max(1, qtyCap))

// ─────────────────────────────────────────────────────────────────────────
//  執行（訊號 K 收盤確認 → 下一根開盤成交）
// ─────────────────────────────────────────────────────────────────────────
var float activeStop   = na
var float activeTarget = na

if ibsLong
    activeStop   := useAtrStop ? close - riskDist : na
    activeTarget := targetR > 0 ? close + targetR * riskDist : na
    strategy.entry("IBS Long", strategy.long, qty = qty)
    strategy.exit("IBS Long Exit", "IBS Long", stop = activeStop, limit = activeTarget)
if ibsShort
    activeStop   := useAtrStop ? close + riskDist : na
    activeTarget := targetR > 0 ? close - targetR * riskDist : na
    strategy.entry("IBS Short", strategy.short, qty = qty)
    strategy.exit("IBS Short Exit", "IBS Short", stop = activeStop, limit = activeTarget)

if strategy.position_size != 0
    float avgPx = strategy.position_avg_price
    bool beLong  = useBE and strategy.position_size > 0 and high >= avgPx + riskDist
    bool beShort = useBE and strategy.position_size < 0 and low <= avgPx - riskDist
    if beLong
        activeStop := math.max(na(activeStop) ? avgPx : activeStop, avgPx)
    if beShort
        activeStop := math.min(na(activeStop) ? avgPx : activeStop, avgPx)
    if strategy.position_size > 0
        strategy.exit("IBS Long Exit", "IBS Long", stop = activeStop, limit = activeTarget)
    else
        strategy.exit("IBS Short Exit", "IBS Short", stop = activeStop, limit = activeTarget)

    int held = bar_index - strategy.opentrades.entry_bar_index(0) + 1
    bool timeExit = held >= maxHold
    bool prevHighExit = usePrevHighExit and not na(prevHigh) and strategy.position_size > 0 and close > prevHigh
    bool prevLowExit  = usePrevHighExit and allowShort and strategy.position_size < 0 and not na(prevLow) and close < prevLow
    if timeExit or prevHighExit or prevLowExit
        strategy.close((strategy.position_size > 0 ? "IBS Long" : "IBS Short"), comment = (timeExit ? "Time" : "PrevDay"), immediately = true)

bool eodFlat = useEodFlat and hour == eodHour and minute >= eodMinute and strategy.position_size != 0
if eodFlat
    strategy.close_all(comment = "EOD Flat")

// JSON Webhook
if useWebhook and (ibsLong or ibsShort)
    payload = "{\"strategy\":\"TnSovereignIbsMeanReversionV6\",\"version\":\"v26.1118.0630\",\"symbol\":\"" + syminfo.ticker + "\",\"tf\":\"" + timeframe.period + "\",\"side\":\"" + (ibsLong ? "BUY" : "SELL") + "\",\"ibs\":" + str.tostring(ibs, "#.###") + ",\"band\":" + str.tostring(band, format.mintick) + ",\"qty\":" + str.tostring(qty) + "}"
    alert(payload, alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────
//  視覺層
// ─────────────────────────────────────────────────────────────────────────
plot(showLevels ? band : na, "Pullback Band", color = color.new(#ab47bc, 20))
plot(showLevels ? ta.highest(high, lenH) : na, "N-Bar High", color = color.new(#ef5350, 60))
plot(showLevels and allowShort ? pushBand : na, "Push Band", color = color.new(#42a5f5, 60))
plot(strategy.position_size != 0 ? activeStop : na, "Active Stop", color = color.new(color.orange, 0), style = plot.style_linebr)
plotshape(showSignals and ibsLong, "IBS Long", shape.triangleup, location.belowbar, color = color.new(color.lime, 0), size = size.tiny, text = "IBS")
plotshape(showSignals and ibsShort, "IBS Short", shape.triangledown, location.abovebar, color = color.new(color.red, 0), size = size.tiny, text = "IBS")
bgcolor(ibs < ibsTh ? color.new(color.green, 96) : ibs > 1.0 - ibsTh ? color.new(color.red, 96) : na)

// ─────────────────────────────────────────────────────────────────────────
//  因果儀表板
// ─────────────────────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 8, border_width = 1, border_color = color.new(#8a8f98, 70))
if barstate.islast and showDash
    string sigTxt = ibsLong ? "IBS LONG" : ibsShort ? "IBS SHORT" : "WAIT"
    string posTxt = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    string holdTxt = strategy.position_size != 0 ? str.tostring(bar_index - strategy.opentrades.entry_bar_index(0) + 1) + "/" + str.tostring(maxHold) : "—"
    table.cell(dash, 0, 0, "版本", text_color = color.new(#8a8f98, 0), text_size = size.small)
    table.cell(dash, 1, 0, "v26.1118.0630", text_color = color.new(#e8ecf1, 0), text_size = size.small)
    table.cell(dash, 0, 1, "訊號", text_color = color.new(#8a8f98, 0), text_size = size.small)
    table.cell(dash, 1, 1, sigTxt, text_color = ibsLong or ibsShort ? color.new(#00e5a0, 0) : color.new(#e8ecf1, 0), text_size = size.small)
    table.cell(dash, 0, 2, "IBS / 門檻", text_color = color.new(#8a8f98, 0), text_size = size.small)
    table.cell(dash, 1, 2, str.tostring(ibs, "#.###") + " / " + str.tostring(ibsTh, "#.##"), text_color = color.new(#e8ecf1, 0), text_size = size.small)
    table.cell(dash, 0, 3, "收盤 / 拉回帶", text_color = color.new(#8a8f98, 0), text_size = size.small)
    table.cell(dash, 1, 3, str.tostring(close, format.mintick) + " / " + str.tostring(band, format.mintick), text_color = color.new(#e8ecf1, 0), text_size = size.small)
    table.cell(dash, 0, 4, "日線體制", text_color = color.new(#8a8f98, 0), text_size = size.small)
    table.cell(dash, 1, 4, not useDaily ? "OFF" : (not na(dEma) ? (close > dEma ? "BULL" : "BEAR") : "N/A"), text_color = color.new(#e8ecf1, 0), text_size = size.small)
    table.cell(dash, 0, 5, "RVOL", text_color = color.new(#8a8f98, 0), text_size = size.small)
    table.cell(dash, 1, 5, not useRvol ? "OFF" : (na(rvolV) ? "N/A" : str.tostring(rvolV, "#.##")), text_color = color.new(#e8ecf1, 0), text_size = size.small)
    table.cell(dash, 0, 6, "部位 / 持倉", text_color = color.new(#8a8f98, 0), text_size = size.small)
    table.cell(dash, 1, 6, posTxt + " " + holdTxt, text_color = color.new(#e8ecf1, 0), text_size = size.small)
    table.cell(dash, 0, 7, "淨損益", text_color = color.new(#8a8f98, 0), text_size = size.small)
    table.cell(dash, 1, 7, str.tostring(strategy.netprofit, format.mintick), text_color = strategy.netprofit >= 0 ? color.new(#00e5a0, 0) : color.new(#ff4d6d, 0), text_size = size.small)

// ═══════════════════════════════════════════════════════════════════════════
//  DATA NOTES
//  · 全庫 grep -il "ibs" 之既有命中皆為 i_ibStartHour（Initial Balance）
//    或 Fibonacci 之子串，並無以 Internal Bar Strength 為進場證據者。
//  · 原作者無停損；本版 ATR 停損可關閉以還原原邏輯，但預設強制開啟。
//  · IBS 屬「收盤位置」微觀證據，需與日線體制 / RVOL / 風險紀律合用，
//    本庫未經獨立回測驗證，不主張任何績效。
// ═══════════════════════════════════════════════════════════════════════════
