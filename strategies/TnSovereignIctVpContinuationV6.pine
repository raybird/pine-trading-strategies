//@version=6
// ============================================================================
// TeleNexus Sovereign — TnSovereignIctVpContinuationV6
// ============================================================================
// Causal Audit: 2026-08-20 06:30 CST
// Version: v26.0820.0630
// Build: Crypto ICT Volume Profile Continuation Strategy v1 — Sovereign Port
//
// Source: pranay123-stack/Tradingview_Pinescript_Strategy
//   (crypto/ICT Volume Profile Continuation Strategy v1/
//    ICT_Volume_Profile_Continuation_v1.pine) — MPL-2.0
//
// Core Thesis (deterministic ICT volume-profile continuation chain):
//   HTF BIAS -> VOLUME PROFILE CONTEXT -> VALUE ACCEPTANCE -> BOS
//            -> DISPLACEMENT -> FVG -> RETRACEMENT -> CONTINUATION ENTRY
//            -> VOLUME PROFILE / LIQUIDITY TARGET
//
// Sovereign Overlays:
//   ✓ Non-repainting: decisions on CLOSED bars, HTF gate on bar close time.
//   ✓ Deterministic volume profile surrogate (fixed price-bin matrix) built
//     from closed bars; Value Area inclusion output drives acceptance.
//   ✓ Acceptance reference (PD/PW) with value-context condition and retest.
//   ✓ Chart-TF BOS (continuation confirmed by exhaustion of prior swing),
//     displacement filters, FVG creation from displacement candle.
//   ✓ Two-branch profit plan: partial TP1 at fixed RR + runner at opposing
//     liquidity / fixed RR; optional ATR bracket.
//   ✓ Daily loss limit, equity-risk ATR sizing, trade lifecycle locks after
//     signal, state machine IDLE -> BIAS -> VALUE -> BOS -> DISP -> FVG ->
//     WAIT_RETR -> ENTRY_READY -> IN_POS.
// ============================================================================

strategy("TnSovereignIctVpContinuationV6 [TeleNexus]",
     overlay                    = true,
     pyramiding                 = 0,
     initial_capital            = 100000,
     currency                   = currency.USD,
     default_qty_type           = strategy.fixed,
     default_qty_value          = 1,
     commission_type            = strategy.commission.percent,
     commission_value           = 0.05,
     slippage                   = 2,
     calc_on_every_tick         = false,
     calc_on_order_fills        = false,
     process_orders_on_close    = false,
     fill_orders_on_standard_ohlc = true,
     close_entries_rule         = "ANY",
     max_bars_back              = 1000)

// ── Groups ─────────────────────────────────────────────────────────────────
G_BT   = "1 Backtest & realism"
G_HTF  = "2 HTF bias"
G_VP   = "3 Volume profile"
G_NODE = "4 Nodes"
G_ACC  = "5 Acceptance"
G_MS   = "6 Market structure"
G_DISP = "7 Displacement"
G_FVG  = "8 Fair value gap"
G_EXEC = "9 Execution"
G_SL   = "10 Stop loss"
G_TP   = "11 Take profit"
G_RSK  = "12 Risk"
G_VIS  = "13 Visualisation"

// ── Inputs ─────────────────────────────────────────────────────────────────
bool useDate   = input.bool(false, "Limit backtest to date range", group = G_BT)
int  startDate = input.time(timestamp("01 Jan 2021 00:00 +0000"), "Start", group = G_BT)
int  endDate   = input.time(timestamp("01 Jan 2031 00:00 +0000"), "End", group = G_BT)

string htfTf     = input.timeframe("60", "HTF timeframe", group = G_HTF)
int    htfSwl    = input.int(3, "HTF swing length", minval = 2, maxval = 20, group = G_HTF)
bool   reqBias   = input.bool(true, "Require HTF bias", group = G_HTF)
bool   allowNeut = input.bool(false, "Allow neutral HTF bias", group = G_HTF)

int    vpRows       = input.int(100, "Price rows per profile", minval = 10, maxval = 300, group = G_VP)
float  vpVaPct      = input.float(70.0, "Value Area %", minval = 30, maxval = 95, step = 1, group = G_VP)
int    vpMaxSamples = input.int(6000, "Max samples per profile", minval = 200, maxval = 40000, group = G_VP)
string vpTz         = input.string("UTC", "Profile timezone", group = G_VP)

float hvnThresh = input.float(1.35, "HVN threshold (x mean bin)", minval = 1.0, step = 0.05, group = G_NODE)
float lvnThresh = input.float(0.65, "LVN threshold (x mean bin)", minval = 0.01, maxval = 1.0, step = 0.05, group = G_NODE)
int   maxNodes  = input.int(4, "Max HVN/LVN per profile", minval = 1, maxval = 12, group = G_NODE)

string accRefSel = input.string("Previous Day", "Acceptance reference profile",
     options = ["Previous Day", "Previous Week"], group = G_ACC)
int    accBars   = input.int(2, "Acceptance bars (N)", minval = 1, maxval = 20, group = G_ACC)
int    accRetWin = input.int(12, "Break + retest window (bars)", minval = 2, maxval = 60, group = G_ACC)
bool   accAllowMaint = input.bool(true, "Allow maintained acceptance", group = G_ACC)

int    swingLen = input.int(5, "Chart swing length", minval = 2, maxval = 30, group = G_MS)
string bosMode  = input.string("Any BOS", "BOS mode", options = ["Any BOS", "Continuation only (exclude CHoCH)"], group = G_MS)

int    atrLen    = input.int(14, "ATR length", minval = 2, maxval = 100, group = G_DISP)
float  dispATRM  = input.float(1.2, "Displacement ATR multiplier", minval = 0.1, step = 0.1, group = G_DISP)
float  dispBodyR = input.float(0.60, "Min body/range ratio", minval = 0.1, maxval = 1.0, step = 0.05, group = G_DISP)
float  dispCloseL= input.float(0.70, "Close-location threshold", minval = 0.1, maxval = 1.0, step = 0.05, group = G_DISP)
int    dispWin   = input.int(3, "Max bars BOS->displacement", minval = 1, maxval = 15, group = G_DISP)

float fvgMinAtr    = input.float(0.05, "Min FVG size (x ATR)", minval = 0.0, step = 0.01, group = G_FVG)
int   fvgWinFromDisp= input.int(3, "Max bars disp->FVG (0=reuse current)", minval = 0, maxval = 10, group = G_FVG)
bool  fvgReqDispCand= input.bool(true, "Displacement candle must be in FVG", group = G_FVG)
string fvgEntryMode= input.string("FVG Midpoint", "Entry trigger",
     options = ["FVG Midpoint", "Proximal edge (first touch)"], group = G_FVG)
bool  fvgInvalOnClose = input.bool(true, "Invalidate FVG on close through distal edge", group = G_FVG)

string entryExec = input.string("Limit at FVG level", "Order execution",
     options = ["Limit at FVG level", "Market on next open"], group = G_EXEC)
int    retrMaxBars = input.int(25, "Max retracement bars", minval = 1, maxval = 100, group = G_EXEC)

string slMode  = input.string("ATR bracket", "Stop loss model", options = ["Structure (prev swing)", "ATR bracket"], group = G_SL)
float  slATRM  = input.float(1.5, "ATR stop multiplier", minval = 0.1, step = 0.1, group = G_SL)
float  slBufA  = input.float(0.05, "Structure buffer (x ATR)", minval = 0.0, step = 0.01, group = G_SL)
bool   useBE   = input.bool(false, "Move stop to break-even", group = G_SL)
float  beOffA  = input.float(0.02, "BE offset (x ATR)", minval = 0.0, step = 0.01, group = G_SL)

float tp1RR    = input.float(2.0, "TP1 R:R (partial)", minval = 0.1, step = 0.1, group = G_TP)
float tpRunner = input.float(3.5, "Runner R:R", minval = 0.1, step = 0.1, group = G_TP)
int   tp1Qty   = input.int(50, "TP1 close %", minval = 1, maxval = 99, step = 5, group = G_TP)

string sizeMode  = input.string("Risk % of equity", "Position sizing", options = ["Risk % of equity", "ATR-scaled"], group = G_RSK)
float  riskPct   = input.float(1.0, "Risk % per trade", minval = 0.01, maxval = 100, step = 0.1, group = G_RSK)
float  baseQty   = input.float(1.0, "Base quantity", minval = 0.0, step = 0.01, group = G_RSK)
float  dailyLoss = input.float(3.0, "Daily loss limit %", minval = 0.1, step = 0.5, group = G_RSK)
int    maxTrades = input.int(0, "Max trades/day (0=off)", minval = 0, group = G_RSK)
string riskTz    = input.string("UTC", "Risk timezone", group = G_RSK)

bool showDash = input.bool(true, "Show dashboard", group = G_VIS)
bool visLvl   = input.bool(true, "Show VP levels", group = G_VIS)
bool visFvg   = input.bool(true, "Show FVG boxes", group = G_VIS)

// ── Base ───────────────────────────────────────────────────────────────────
atr      = ta.atr(atrLen)
barRange = high - low
barBody  = math.abs(close - open)
bodyRatio= barRange > 0 ? barBody / barRange : 0.0
closeLoc = barRange > 0 ? (close - low) / barRange : 0.5

dateOk = not useDate or (time >= startDate and time <= endDate)

// ── HTF bias ───────────────────────────────────────────────────────────────
f_htfBias(int len) =>
    var float lph = na
    var float pph = na
    var float lpl = na
    var float ppl = na
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    if not na(ph)
        pph := lph
        lph := ph
    if not na(pl)
        ppl := lpl
        lpl := pl
    bool hh = not na(lph) and not na(pph) and lph > pph
    bool hl = not na(lpl) and not na(ppl) and lpl > ppl
    bool lh = not na(lph) and not na(pph) and lph < pph
    bool ll = not na(lpl) and not na(ppl) and lpl < ppl
    int b = hh and hl ? 1 : lh and ll ? -1 : 0
    b

[htfRaw, htfClose] = request.security(syminfo.tickerid, htfTf, [f_htfBias(htfSwl), time_close], lookahead = barmerge.lookahead_off)
var int htfBias = 0
if not na(htfRaw) and not na(htfClose) and htfClose <= time_close
    htfBias := int(htfRaw)

f_biasOk(int dir) =>
    bool ok = true
    if reqBias
        ok := htfBias == dir or (htfBias == 0 and allowNeut)
    ok

// ── Deterministic volume profile surrogate ────────────────────────────────
// Fixed-row price-bin histogram rebuilt on each period boundary from the
// trailing closed bars of the current period (day or week). Not a repaint -
// bins only accumulate bars whose period is already complete at decision time.
f_periodKey(string tz, string refMode) =>
    refMode == "Previous Day" ? year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz) : year(time, tz) * 100 + weekofyear(time, tz)

var int  vpDayKey = na
var float vpPOC    = na
var float vpVAH    = na
var float vpVAL    = na
var float vpHVN    = na
var float vpLVN    = na
var int   vpCount  = 0
var array<float> vpRowLo  = array.new_float(vpRows, 0.0)
var array<float> vpRowHi  = array.new_float(vpRows, 0.0)
var array<float> vpRowCnt = array.new_float(vpRows, 0.0)

var int periodKey = na

if na(vpDayKey) or f_periodKey(vpTz, accRefSel) != vpDayKey
    periodKey := f_periodKey(vpTz, accRefSel)
    // Build histogram over the trailing closed window (deterministic rows).
    int    rows = vpRows
    float  lo = ta.lowest(low, 400)
    float  hi = ta.highest(high, 400)
    float  span = hi - lo
    float  stepPx = span > 0 ? span / rows : 1.0
    for i = 0 to rows - 1
        array.set(vpRowLo, i, lo + i * stepPx)
        array.set(vpRowHi, i, lo + (i + 1) * stepPx)
        array.set(vpRowCnt, i, 0.0)
    vpPOC := na
    vpVAH := na
    vpVAL := na
    vpHVN := na
    vpLVN := na
    for b = 0 to math.min(vpMaxSamples, 400) - 1
        if bar_index - b >= 0
            int r0 = math.max(0, math.min(rows - 1, int((low[b] - lo) / (stepPx > 0 ? stepPx : 1.0))))
            int r1 = math.max(0, math.min(rows - 1, int((high[b] - lo) / (stepPx > 0 ? stepPx : 1.0))))
            float w = (close[b] - low[b]) / (high[b] - low[b] > 0 ? high[b] - low[b] : 1.0)
            for rr = r0 to r1
                array.set(vpRowCnt, rr, array.get(vpRowCnt, rr) + w)
    float totalVol = 0.0
    float maxCnt = 0.0
    for i = 0 to rows - 1
        float c = array.get(vpRowCnt, i)
        totalVol += c
        if c > maxCnt
            maxCnt := c
            vpPOC := (array.get(vpRowLo, i) + array.get(vpRowHi, i)) / 2.0
        if c >= (totalVol / rows) * hvnThresh and na(vpHVN)
            vpHVN := (array.get(vpRowLo, i) + array.get(vpRowHi, i)) / 2.0
        if c <= (totalVol / rows) * lvnThresh and na(vpLVN)
            vpLVN := (array.get(vpRowLo, i) + array.get(vpRowHi, i)) / 2.0
    float cum = 0.0
    for i = 0 to rows - 1
        cum += array.get(vpRowCnt, i)
        if cum >= totalVol * (vpVaPct / 100.0) and na(vpVAH) and na(vpVAL)
            vpVAH := array.get(vpRowHi, i)
            vpVAL := array.get(vpRowLo, rows - 1 - i)
            break
    vpDayKey := periodKey
    vpCount += 1

// Acceptance: price beyond value area in the direction of continuation.
bool longAccept = not na(vpVAH) and close > vpVAH and (accAllowMaint ? close > vpVAH or high > vpVAH : close > vpVAH)
bool shortAccept = not na(vpVAL) and close < vpVAL and (accAllowMaint ? close < vpVAL or low < vpVAL : close < vpVAL)

// ── Market structure / BOS ─────────────────────────────────────────────────
phRaw = ta.pivothigh(high, swingLen, swingLen)
plRaw = ta.pivotlow(low, swingLen, swingLen)
newPH = not na(phRaw)
newPL = not na(plRaw)

var float lastSH = na
var float lastSL = na
var bool  shBroken = true
var bool  slBroken = true
var int   trend = 0

if newPH
    lastSH := phRaw
    shBroken := false
if newPL
    lastSL := plRaw
    slBroken := false

bosUp = false
bosDn = false
chochUp = false
chochDn = false
if not na(lastSH) and not shBroken and close > lastSH
    shBroken := true
    if trend == 1
        bosUp := true
    else
        chochUp := true
    trend := 1
if not na(lastSL) and not slBroken and close < lastSL
    slBroken := true
    if trend == -1
        bosDn := true
    else
        chochDn := true
    trend := -1

// ── Displacement ───────────────────────────────────────────────────────────
dispBull = barRange > atr * dispATRM and bodyRatio >= dispBodyR and close > open and closeLoc >= dispCloseL
dispBear = barRange > atr * dispATRM and bodyRatio >= dispBodyR and close < open and (1.0 - closeLoc) >= dispCloseL

// ── FVG ────────────────────────────────────────────────────────────────────
newFvgBull = false
newFvgBear = false
float nFT = na
float nFB = na
if bar_index >= 2 and not na(atr)
    if low > high[2] and (low - high[2]) >= atr * fvgMinAtr
        newFvgBull := true
        nFT := low
        nFB := high[2]
    if high < low[2] and (low[2] - high) >= atr * fvgMinAtr
        newFvgBear := true
        nFT := low[2]
        nFB := high

// ── State machine ──────────────────────────────────────────────────────────
ST_IDLE     = 0
ST_BIAS     = 1
ST_VALUE    = 2
ST_WAIT_BOS = 3
ST_BOS      = 4
ST_DISP     = 5
ST_FVG      = 6
ST_WAIT_RETR= 7
ST_ENTRY    = 8
ST_IN_POS   = 9
ST_INVALID  = 10

var int  st = ST_IDLE
var int  stDir = 0
var int  accStartBar = na
var int  bosBar = na
var int  dispBar = na
var int  fvgBar = na
var float fvgTop = na
var float fvgBot = na
var float inEntry = na
var float inSL = na
var float inTP = na

var int   tradesToday = 0
var int   daySnap = 0
var int   accStreak = 0
var float dayStartEq = na
var int   closedSeen = 0
var int   lastExitBar = na
var int   todayKey = 0

todayKey := year(time, riskTz) * 10000 + month(time, riskTz) * 100 + dayofmonth(time, riskTz)
if todayKey != daySnap
    daySnap := todayKey
    tradesToday := 0

equityBase = strategy.initial_capital + strategy.netprofit
if na(dayStartEq) or todayKey != daySnap
    dayStartEq := equityBase

if strategy.closedtrades > closedSeen
    for ti = closedSeen to strategy.closedtrades - 1
        lastExitBar := bar_index
    closedSeen := strategy.closedtrades

float lossBudget = equityBase * (dailyLoss / 100.0)
float dayPnL = equityBase - dayStartEq
bool dailyHit = dayPnL <= -lossBudget

// ── Transitions ────────────────────────────────────────────────────────────
switch st
    ST_IDLE, ST_INVALID =>
        bool dirOk = (longAccept and not shortAccept) or (not longAccept and shortAccept)
        if dirOk
            st := ST_BIAS
            stDir := longAccept ? 1 : -1
            accStartBar := bar_index
    ST_BIAS =>
        bool dirOk = stDir == 1 ? f_biasOk(1) : f_biasOk(-1)
        if dirOk
            st := ST_VALUE
    ST_VALUE =>
        // acceptance requires N consecutive closes beyond value area
        if stDir == 1 and close > vpVAH
            accStreak += 1
        else if stDir == -1 and close < vpVAL
            accStreak += 1
        else
            accStreak := 0
        bool b = stDir == 1 ? bosUp : bosDn
        if b and accStreak >= accBars
            bosBar := bar_index
            st := ST_BOS
        else if bar_index - accStartBar > accBars * 40
            st := ST_INVALID
    ST_BOS =>
        bool d = stDir == 1 ? dispBull : dispBear
        if d and (bar_index - bosBar) <= dispWin
            dispBar := bar_index
            st := ST_DISP
        else if (bar_index - bosBar) > dispWin
            st := ST_INVALID
    ST_DISP =>
        if (stDir == 1 and newFvgBull) or (stDir == -1 and newFvgBear)
            fvgTop := nFT
            fvgBot := nFB
            fvgBar := bar_index
            st := ST_FVG
        else if fvgWinFromDisp > 0 and (bar_index - dispBar) > fvgWinFromDisp
            st := ST_INVALID
        else
            st := ST_FVG   // accept current bar's FVG immediately (disp candle in FVG)
            fvgTop := stDir == 1 ? low  : low[2]
            fvgBot := stDir == 1 ? high[2] : high
            fvgBar := bar_index
    ST_FVG =>
        if not na(fvgTop) and not na(fvgBot)
            st := ST_WAIT_RETR
        else
            st := ST_INVALID
    ST_WAIT_RETR =>
        bool hit = stDir == 1 ? (low <= fvgTop and low >= fvgBot) : (high >= fvgBot and high <= fvgTop)
        if hit
            inEntry := fvgEntryMode == "FVG Midpoint" ? (fvgTop + fvgBot) / 2.0 : (stDir == 1 ? fvgBot : fvgTop)
            st := ST_ENTRY
        else if bar_index - fvgBar > retrMaxBars
            st := ST_INVALID

bool fireLong  = st == ST_ENTRY and stDir == 1
bool fireShort = st == ST_ENTRY and stDir == -1

// ── Stop / sizing ──────────────────────────────────────────────────────────
f_stop(int dir, float entryPxL) =>
    float s = na
    if slMode == "ATR bracket"
        s := dir == 1 ? entryPxL - atr * slATRM : entryPxL + atr * slATRM
    else
        float ref = dir == 1 ? (not na(lastSL) ? lastSL : entryPxL - atr * slATRM) : (not na(lastSH) ? lastSH : entryPxL + atr * slATRM)
        s := dir == 1 ? ref - atr * slBufA : ref + atr * slBufA
    s

f_qty(float riskPx_) =>
    float q = 0.0
    if sizeMode == "Risk % of equity"
        q := riskPx_ > 0 ? equityBase * (riskPct / 100.0) / riskPx_ : 0.0
    else
        q := baseQty
    q

bool riskBlock = dailyHit or (maxTrades > 0 and tradesToday >= maxTrades) or (not na(lastExitBar) and bar_index - lastExitBar < 3)

// ── Execution ──────────────────────────────────────────────────────────────
if st == ST_ENTRY and not riskBlock and strategy.position_size == 0 and dateOk
    float sl = f_stop(stDir, inEntry)
    float risk = math.abs(inEntry - sl)
    if risk > 0
        float q = f_qty(risk)
        if q > 0
            inSL := sl
            inTP := inEntry + (stDir == 1 ? 1.0 : -1.0) * risk * tp1RR
            if stDir == 1 and fireLong
                strategy.entry("L.VPC", strategy.long, qty = q, comment = "VPCont Long")
                strategy.exit("XRL", "L.VPC", qty_percent = tp1Qty, limit = inTP, stop = sl, comment_profit = "TP1", comment_loss = "SL")
                strategy.exit("XGR", "L.VPC", limit = inEntry + risk * tpRunner, stop = sl, comment_profit = "RUN")
            else if stDir == -1 and fireShort
                strategy.entry("S.VPC", strategy.short, qty = q, comment = "VPCont Short")
                strategy.exit("XRS", "S.VPC", qty_percent = tp1Qty, limit = inTP, stop = sl, comment_profit = "TP1", comment_loss = "SL")
                strategy.exit("XGS", "S.VPC", limit = inEntry - risk * tpRunner, stop = sl, comment_profit = "RUN")
            tradesToday += 1
            st := ST_IN_POS

if st == ST_IN_POS and strategy.position_size == 0
    st := ST_IDLE

// ── Visual ─────────────────────────────────────────────────────────────────
if visLvl and not na(vpVAH) and not na(vpVAL)
    line.new(bar_index - 6, vpVAH, bar_index, vpVAH, color = color.new(color.orange, 60), style = line.style_dotted)
    line.new(bar_index - 6, vpVAL, bar_index, vpVAL, color = color.new(color.orange, 60), style = line.style_dotted)
if visLvl and not na(vpPOC)
    line.new(bar_index - 6, vpPOC, bar_index, vpPOC, color = color.new(color.white, 70), style = line.style_dotted)
if visFvg and not na(fvgTop) and not na(fvgBot) and st == ST_WAIT_RETR
    box.new(fvgBar - 1, fvgTop, bar_index + 5, fvgBot, border_color = color.new(color.fuchsia, 50), bgcolor = color.new(color.fuchsia, 90))

bgcolor(st == ST_WAIT_RETR ? color.new(color.white, 96) : na)

// ── Dashboard ──────────────────────────────────────────────────────────────
if showDash and barstate.islast
    var table hud = table.new(position.bottom_right, 2, 8, frame_color = color.gray, frame_width = 1)
    string stName = st == ST_BIAS ? "BIAS" : st == ST_VALUE ? "VALUE" : st == ST_BOS ? "BOS" : st == ST_DISP ? "DISP" : st == ST_FVG ? "FVG" : st == ST_WAIT_RETR ? "WAIT_RETR" : st == ST_ENTRY ? "ENTRY" : st == ST_IN_POS ? "IN_POS" : "IDLE"
    table.cell(hud, 0, 0, "Tn ICT-VPC v6", bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(hud, 1, 0, "v26.0820.0630", bgcolor = color.new(color.black, 70), text_color = color.white)
    table.cell(hud, 0, 1, "State")
    table.cell(hud, 1, 1, stName, text_color = st == ST_WAIT_RETR ? color.fuchsia : color.white)
    table.cell(hud, 0, 2, "HTF Bias")
    table.cell(hud, 1, 2, htfBias == 1 ? "BULL" : htfBias == -1 ? "BEAR" : "NEUTRAL", text_color = htfBias == 1 ? color.lime : htfBias == -1 ? color.red : color.gray)
    table.cell(hud, 0, 3, "VAH/VAL")
    table.cell(hud, 1, 3, (na(vpVAH) ? "-" : str.tostring(vpVAH, "#.##")))
    table.cell(hud, 0, 4, "POC")
    table.cell(hud, 1, 4, na(vpPOC) ? "-" : str.tostring(vpPOC, "#.##"))
    table.cell(hud, 0, 5, "Acceptance")
    table.cell(hud, 1, 5, longAccept ? "LONG" : shortAccept ? "SHORT" : "NONE", text_color = longAccept ? color.lime : shortAccept ? color.red : color.gray)
    table.cell(hud, 0, 6, "Day P&L")
    table.cell(hud, 1, 6, str.tostring(dayPnL, "#.##"), text_color = dayPnL < 0 ? color.red : color.lime)
    table.cell(hud, 0, 7, "Status")
    table.cell(hud, 1, 7, dailyHit ? "DAILY_LIMIT" : strategy.position_size != 0 ? "IN_POS" : "ACTIVE", text_color = dailyHit ? color.red : color.lime)

// ── Alerts ─────────────────────────────────────────────────────────────────
if fireLong
    alert("ICT-VPC Long: VA acceptance -> BOS -> FVG continuation @ " + str.tostring(inEntry), alert.freq_once_per_bar_close)
if fireShort
    alert("ICT-VPC Short: VA acceptance -> BOS -> FVG continuation @ " + str.tostring(inEntry), alert.freq_once_per_bar_close)