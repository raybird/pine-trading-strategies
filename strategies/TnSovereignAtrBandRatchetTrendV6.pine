//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  TeleNexus Sovereign ATR Band Ratchet Trend V6
//  主權化移植自 loctai/pinescript (MIT License)
//  src/scripts/trend_following.pine — "Trend Following Strategy"
// ═══════════════════════════════════════════════════════════════════════════
//  Version   : v26.1021.1830
//  Timestamp : 2026-10-21 18:30 CST (UTC+8)
//  Source    : loctai/pinescript — MIT — src/scripts/trend_following.pine
//  Core      : EMA 基底 + ATR 帶狀棘輪（單向棘輪）→ 收盤穿越帶緣即停損反手
//              （stop-and-reverse）→ 趨勢中回測 EMA 基底再進場（pullback
//              re-entry）→ 帶緣即真實盤中停損 + R 倍數停利 → 風險距離定倉
//              （risk% / 距停損距離，槓桿上限封頂）
//
//  主權化要點（相對原作者）
//    1. 加入 HTF 趨勢偏見閘門（request.security [1] 滯後 + lookahead_on
//       = 已收盤 HTF 序列，零前視偏差，預設關閉以保真原始行為）
//    2. 加入時段進場濾網、每日強制平倉、持倉 K 棒上限、翻轉冷卻
//    3. 倉位數量改以 int(math.floor(...)) 落地，滿足 Pine qty 整數契約
//    4. 補上 R 倍數統計面板與 JSON Webhook 告警
//    5. 移除任何績效宣稱字串；本系統不作績效保證
//
//  非重繪契約：所有訊號僅於「已收盤 K 棒」判定（barstate.isconfirmed），
//  訂單於下一根 K 棒開盤成交（process_orders_on_close = false）。
//  棘輪帶僅由已收盤之 basis/ATR 更新，不含任何未來函數引用。
// ═══════════════════════════════════════════════════════════════════════════
strategy("Tn Sovereign ATR Band Ratchet Trend V6", "TnABRT_v26",
     overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.percent,
     commission_value = 0.04,
     slippage = 2,
     pyramiding = 0,
     calc_on_every_tick = false,
     process_orders_on_close = false,
     margin_long = 0, margin_short = 0,
     max_bars_back = 500)

// ─────────────────────────────────────────────────────────────────────────
//  INPUTS
// ─────────────────────────────────────────────────────────────────────────
gS = "① 趨勢引擎 (Trend Engine)"
baseLen = input.int(21,   "EMA 基底週期", minval = 2,  maxval = 300, group = gS)
atrLen  = input.int(10,   "ATR 週期",     minval = 2,  maxval = 100, group = gS)
mult    = input.float(2.0, "帶寬 (× ATR)", minval = 0.5, step = 0.25, group = gS,
     tooltip = "數值越小＝帶緣越靠近基底＝反手次數與交易頻率越高。")
longsOn  = input.bool(true, "允許做多", group = gS)
shortsOn = input.bool(true, "允許做空", group = gS)

gT = "② 進出場 (Entries & Exits)"
pullOn   = input.bool(true,  "啟用回測再進場 (Pullback)", group = gT,
     tooltip = "趨勢中且空倉時，收盤重新穿越 EMA 基底即順趨勢再進場。")
tpOn     = input.bool(true,  "啟用 R 倍數停利", group = gT)
tpR      = input.float(2.0,  "停利目標 (R)", minval = 0.25, maxval = 20, step = 0.25, group = gT,
     tooltip = "R ＝ 進場當下「收盤價到帶緣的距離」。")
maxHoldBars = input.int(0, "持倉 K 棒上限 (0 = 不限)", minval = 0, maxval = 2000, group = gT)
flipCooldown = input.int(0, "反手冷卻 K 棒 (0 = 不限)", minval = 0, maxval = 200, group = gT)

gF = "③ 濾網 (Filters)"
useHtfBias = input.bool(false, "啟用 HTF 趨勢偏見閘門", group = gF)
htfTf      = input.timeframe("60", "HTF 週期", group = gF)
htfLen     = input.int(200, "HTF EMA 週期", minval = 20, group = gF)
useSession = input.bool(false, "啟用時段進場濾網", group = gF)
sessionStr = input.session("0930-1600", "進場時段", group = gF)
sessionTz  = input.string("America/New_York", "時段時區", group = gF)
useEodFlat = input.bool(false, "啟用每日強制平倉", group = gF)
eodHour    = input.int(15, "強制平倉時 (時)", minval = 0, maxval = 23, group = gF)
eodMinute  = input.int(55, "強制平倉分 (分)", minval = 0, maxval = 59, group = gF)

gR = "④ 風險 (Risk)"
riskPct = input.float(1.0, "單筆風險 (% 權益)", minval = 0.01, maxval = 10, step = 0.1, group = gR)
maxLev  = input.float(3.0, "最大槓桿 (名目/權益)", minval = 0.1, maxval = 50, step = 0.1, group = gR,
     tooltip = "倉位名目價值 / 權益 的上限，用於封頂風險距離定倉。")
minQty  = input.int(1, "最小下單數量", minval = 1, group = gR)

gV = "⑤ 視覺 (Visuals)"
bullCol    = input.color(#19f5c6, "多頭色", group = gV)
bearCol    = input.color(#ff3d81, "空頭色", group = gV)
showGlow   = input.bool(true,  "帶緣光暈", group = gV)
showRibbon = input.bool(true,  "EMA→帶緣 綢帶填充", group = gV)
showMarks  = input.bool(true,  "反手菱形 / 回測圓點", group = gV)
showLabels = input.bool(true,  "BUY / SELL 標籤", group = gV)
colorBars  = input.bool(false, "依趨勢著色 K 棒", group = gV)
showPanel  = input.bool(true,  "顯示統計面板", group = gV)
useWebhook = input.bool(false, "啟用 JSON Webhook 告警", group = gV)

// ─────────────────────────────────────────────────────────────────────────
//  TREND ENGINE — EMA 基底 + ATR 單向棘輪帶
//  lo ＝ 多頭趨勢的支撐帶緣；hi ＝ 空頭趨勢的阻力帶緣。
//  兩者僅朝有利於當前趨勢的方向移動，除非價格收盤已越過該帶緣（重置）。
// ─────────────────────────────────────────────────────────────────────────
float basis = ta.ema(close, baseLen)
float atrV  = ta.atr(atrLen)
float loNew = basis - mult * atrV
float hiNew = basis + mult * atrV

var float lo  = na
var float hi  = na
var int   dir = 0

float pLo = lo[1]
float pHi = hi[1]
lo := na(pLo) ? loNew : (loNew > pLo or close[1] < pLo) ? loNew : pLo
hi := na(pHi) ? hiNew : (hiNew < pHi or close[1] > pHi) ? hiNew : pHi

// ── HTF 趨勢偏見（已收盤 HTF 序列，零前視偏差）──────────────────────────
float htfEma   = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfLen)[1], lookahead = barmerge.lookahead_on)
float htfClose = request.security(syminfo.tickerid, htfTf, close[1],                  lookahead = barmerge.lookahead_on)
bool  htfBull  = useHtfBias and not na(htfEma) and not na(htfClose) and htfClose > htfEma
bool  htfBear  = useHtfBias and not na(htfEma) and not na(htfClose) and htfClose < htfEma

// ── 趨勢狀態機 ─────────────────────────────────────────────────────────
if dir == 0 and not na(lo) and not na(hi)
    dir := close > basis ? 1 : -1
else if dir == 1 and close < pLo
    dir := -1
else if dir == -1 and close > pHi
    dir := 1

int  prevDir  = not na(dir[1]) ? dir[1] : 0
bool flipBull = dir == 1 and prevDir != 1
bool flipBear = dir == -1 and prevDir != -1
float stopLine = dir == 1 ? lo : dir == -1 ? hi : na

// ── 濾網評估 ───────────────────────────────────────────────────────────
bool inSession  = useSession ? not na(time(timeframe.period, sessionStr, sessionTz)) : true
bool eodReached = useEodFlat and (hour > eodHour or (hour == eodHour and minute >= eodMinute))
bool htfOk      = not useHtfBias or (htfBull or htfBear)

var int lastFlipBar = -1000
bool cooldownOk = flipCooldown <= 0 or (bar_index - lastFlipBar) >= flipCooldown

// 回測再進場：趨勢未變、空倉、收盤重新穿越 EMA 基底
bool pullBull = pullOn and dir == 1 and prevDir == 1 and close > basis and close[1] <= basis[1]
     and strategy.position_size == 0 and longsOn and inSession and htfOk and cooldownOk and not eodReached
bool pullBear = pullOn and dir == -1 and prevDir == -1 and close < basis and close[1] >= basis[1]
     and strategy.position_size == 0 and shortsOn and inSession and htfOk and cooldownOk and not eodReached

// ─────────────────────────────────────────────────────────────────────────
//  RISK SIZING — 風險金額 ÷ 進場點到帶緣距離，並以槓桿封頂
//  R ＝ 同一距離，故停損距離與部位大小恆等對齊。
// ─────────────────────────────────────────────────────────────────────────
float dist      = math.abs(close - stopLine)
float riskMoney = strategy.equity * riskPct / 100.0
float qRisk     = not na(dist) and dist > 0 ? riskMoney / (dist * syminfo.pointvalue) : 0.0
float qCap      = strategy.equity * maxLev / (close * syminfo.pointvalue)
float rawQty    = math.min(qRisk, qCap)
int   qty      = na(rawQty) ? 0 : int(math.floor(rawQty))
bool  canSize  = not na(stopLine) and not na(rawQty) and rawQty > 0 and qty >= minQty

var float entryDist = na
var int   barsInTrade = 0

if strategy.position_size != 0
    barsInTrade += 1
else
    barsInTrade := 0

// ─────────────────────────────────────────────────────────────────────────
//  TRADES — 訊號僅於收盤 K 棒成立，訂單於下一根開盤成交
// ─────────────────────────────────────────────────────────────────────────
if canSize and barstate.isconfirmed
    if flipBull
        if longsOn and inSession and htfOk and cooldownOk and not eodReached
            strategy.entry("Long", strategy.long, qty = qty, comment = "Flip")
            entryDist := dist
            lastFlipBar := bar_index
        else if not longsOn and strategy.position_size < 0
            strategy.close("Short", comment = "LongDisabled")
    else if flipBear
        if shortsOn and inSession and htfOk and cooldownOk and not eodReached
            strategy.entry("Short", strategy.short, qty = qty, comment = "Flip")
            entryDist := dist
            lastFlipBar := bar_index
        else if not shortsOn and strategy.position_size > 0
            strategy.close("Long", comment = "ShortDisabled")
    else if pullBull
        strategy.entry("Long", strategy.long, qty = qty, comment = "Pullback")
        entryDist := dist
    else if pullBear
        strategy.entry("Short", strategy.short, qty = qty, comment = "Pullback")
        entryDist := dist

// ── 出場：帶緣＝真實盤中停損（棘輪每根重掛）；R 倍數＝限價停利 ──────
float refPx = strategy.position_size != 0 ? strategy.position_avg_price : close
bool  hasR  = tpOn and not na(entryDist) and entryDist > 0

// 出場：以「持倉方向」而非「趨勢方向」掛單，避免反手當根保護失效
// （多頭部位一律以支撐帶 lo 為停損、空頭部位一律以阻力帶 hi 為停損）
if strategy.position_size > 0
    strategy.exit("Exit L", "Long", stop = lo, limit = hasR ? refPx + tpR * entryDist : na)
else if strategy.position_size < 0
    strategy.exit("Exit S", "Short", stop = hi, limit = hasR ? refPx - tpR * entryDist : na)

// ── 時間類出場 ─────────────────────────────────────────────────────────
if maxHoldBars > 0 and barsInTrade >= maxHoldBars
    strategy.close_all(comment = "MaxHold")
if eodReached and strategy.position_size != 0
    strategy.close_all(comment = "EOD")

// ─────────────────────────────────────────────────────────────────────────
//  VISUALS — 帶緣光暈、綢帶、反手菱形、回測圓點
// ─────────────────────────────────────────────────────────────────────────
color trendCol  = dir == 1 ? bullCol : dir == -1 ? bearCol : chart.fg_color
bool  same      = dir == prevDir
float pressure  = math.max(0.0, math.min(1.0, nz(1.0 - dir * (close - stopLine) / (mult * atrV))))
bool  stopAbove = stopLine > basis

plot(showGlow ? stopLine : na, "帶緣光暈 (外)", same ? color.new(trendCol, int(90 - 15 * pressure)) : na, 12, display = display.pane)
plot(showGlow ? stopLine : na, "帶緣光暈 (內)", same ? color.new(trendCol, int(76 - 28 * pressure)) : na,  6, display = display.pane)
plot(stopLine, "帶緣", same ? trendCol : na, 2, display = display.pane)

basisPlot = plot(basis, "EMA 基底", color.new(trendCol, 72), 1, display = display.pane)
edgePlot  = plot(same ? stopLine : na, "帶緣(綢帶)", display = display.none, editable = false)
strong    = color.new(trendCol, showRibbon ? 70 : 100)
faint     = color.new(trendCol, 100)
fill(basisPlot, edgePlot,
     top_value    = math.max(basis, nz(stopLine, basis)),
     bottom_value = math.min(basis, nz(stopLine, basis)),
     top_color    = stopAbove ? strong : faint,
     bottom_color = stopAbove ? faint : strong,
     title = "綢帶填充")

plotshape(showMarks and flipBull ? stopLine : na, "多頭反手", shape.diamond, location.absolute, bullCol, size = size.small)
plotshape(showMarks and flipBear ? stopLine : na, "空頭反手", shape.diamond, location.absolute, bearCol, size = size.small)
plotshape(showMarks and pullBull, "回測做多", shape.circle, location.belowbar, bullCol, size = size.tiny)
plotshape(showMarks and pullBear, "回測做空", shape.circle, location.abovebar, bearCol, size = size.tiny)
plotshape(showLabels and flipBull, "BUY",  shape.labelup,   location.belowbar, bullCol, text = "BUY",  textcolor = #04110e, size = size.small)
plotshape(showLabels and flipBear, "SELL", shape.labeldown, location.abovebar, bearCol, text = "SELL", textcolor = #ffffff, size = size.small)

barcolor(colorBars and dir != 0 ? trendCol : na, title = "趨勢 K 棒著色")
plot(dir,        title = "趨勢方向",  display = display.none)
plot(flipBull ? 1.0 : 0.0, title = "多頭反手", display = display.none)
plot(flipBear ? 1.0 : 0.0, title = "空頭反手", display = display.none)
plot(pullBull ? 1.0 : 0.0, title = "回測做多", display = display.none)
plot(pullBear ? 1.0 : 0.0, title = "回測做空", display = display.none)
plot(dist,       title = "進場距離",  display = display.none)
plot(qRisk,      title = "風險定量",  display = display.none)
plot(qCap,       title = "槓桿定量",  display = display.none)

// ─────────────────────────────────────────────────────────────────────────
//  STATS PANEL
// ─────────────────────────────────────────────────────────────────────────
var table hud = table.new(position.bottom_right, 2, 6, bgcolor = #10161F, border_color = #26303D, border_width = 1)
if showPanel and barstate.islast
    float pos   = strategy.position_size
    float openR = pos != 0 and entryDist > 0 ? (close - strategy.position_avg_price) * math.sign(pos) / entryDist : na
    int   nTr   = strategy.closedtrades
    float winP  = nTr > 0 ? strategy.wintrades * 100.0 / nTr : na
    float netP  = strategy.netprofit / strategy.initial_capital * 100.0
    color posCol = pos > 0 ? bullCol : pos < 0 ? bearCol : #8793A4
    table.cell(hud, 0, 0, "  趨勢",        text_color = #8793A4, text_halign = text.align_left)
    table.cell(hud, 1, 0, (dir == 1 ? "上升" : dir == -1 ? "下降" : "—") + "  ", text_color = trendCol, text_halign = text.align_right)
    table.cell(hud, 0, 1, "  持倉",        text_color = #8793A4, text_halign = text.align_left)
    table.cell(hud, 1, 1, (pos > 0 ? "多頭" : pos < 0 ? "空頭" : "空倉") + (na(openR) ? "" : "  " + (openR >= 0 ? "+" : "") + str.tostring(openR, "0.0") + " R") + "  ", text_color = posCol, text_halign = text.align_right)
    table.cell(hud, 0, 2, "  進場距離",   text_color = #8793A4, text_halign = text.align_left)
    table.cell(hud, 1, 2, (na(dist) ? "—" : str.tostring(dist, format.mintick)) + "  ", text_color = #E6EDF5, text_halign = text.align_right)
    table.cell(hud, 0, 3, "  交易",        text_color = #8793A4, text_halign = text.align_left)
    table.cell(hud, 1, 3, str.tostring(nTr) + (na(winP) ? "" : "  ·  " + str.tostring(winP, "#") + "% 勝") + "  ", text_color = #E6EDF5, text_halign = text.align_right)
    table.cell(hud, 0, 4, "  淨值",        text_color = #8793A4, text_halign = text.align_left)
    table.cell(hud, 1, 4, (netP >= 0 ? "+" : "") + str.tostring(netP, "0.0") + "%  ", text_color = netP >= 0 ? bullCol : bearCol, text_halign = text.align_right)
    table.cell(hud, 0, 5, "  HTF 偏見",   text_color = #8793A4, text_halign = text.align_left)
    table.cell(hud, 1, 5, (not useHtfBias ? "未啟用" : htfBull ? "偏多" : htfBear ? "偏空" : "—") + "  ", text_color = not useHtfBias ? #8793A4 : htfBull ? bullCol : htfBear ? bearCol : #8793A4, text_halign = text.align_right)

// ─────────────────────────────────────────────────────────────────────────
//  ALERTS — JSON Webhook（可選）＋ 文字告警
// ─────────────────────────────────────────────────────────────────────────
bool bullSignal = barstate.isconfirmed and (flipBull or pullBull)
bool bearSignal = barstate.isconfirmed and (flipBear or pullBear)

if bullSignal or bearSignal
    bool    isLong    = bullSignal
    string  kind      = flipBull or flipBear ? "flip" : "pullback"
    string  side      = isLong ? "BUY" : "SELL"
    string  bandPx    = str.tostring(stopLine, format.mintick)
    string  json = "{\"strategy\":\"TnSovereignAtrBandRatchetTrendV6\"," +
         "\"version\":\"v26.1021.1830\",\"symbol\":\"" + syminfo.ticker + "\"," +
         "\"timeframe\":\"" + timeframe.period + "\",\"side\":\"" + side + "\"," +
         "\"kind\":\"" + kind + "\",\"band\":" + bandPx + ",\"dist\":" + str.tostring(dist, "#.####") + "}"
    alert("Tn ATR Band Ratchet: " + side + " " + syminfo.ticker + " " + timeframe.period +
         (kind == "flip" ? " (flip)" : " (pullback)") + " · 帶緣 " + bandPx, alert.freq_once_per_bar_close)
    if useWebhook
        alert(json, alert.freq_once_per_bar_close)
